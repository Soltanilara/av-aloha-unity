# Credentials -- never commit these.
serviceAccountKey.json
signalingSettings.json

# Unity generated. All of this is rebuilt on open; none of it belongs in git.
Guided-Vision/Library/
Guided-Vision/Temp/
Guided-Vision/Obj/
Guided-Vision/obj/
Guided-Vision/Logs/
Guided-Vision/UserSettings/
Guided-Vision/MemoryCaptures/
Guided-Vision/Recordings/
Guided-Vision/Builds/
Guided-Vision/[Bb]uild/
Guided-Vision/*.csproj
Guided-Vision/*.sln
Guided-Vision/*.user
Guided-Vision/*.pidb
Guided-Vision/*.booproj
Guided-Vision/*.svd
sysinfo.txt
crashlytics-build.properties

# Unity never ignores .meta files for assets that are tracked; it does need the
# ones for ignored folders gone.
Guided-Vision/Assets/AssetStoreTools*

# Local scratch that has accumulated in the working tree.
new_0/
output.mp4
webrtc_env/

# Unity 6 renamed the generated solution, and leaves crash dumps beside the project.
Guided-Vision/*.slnx
Guided-Vision/mono_crash.*

# Android/gradle/ninja scratch from IL2CPP builds: CMake caches and .o files, rebuilt
# every build. This was tracked by accident.
Guided-Vision/.utmp/

# Crash-recovery scenes Unity drops into Assets/ after an editor crash. They are stale
# copies of real scenes and do nothing but throw import errors. Safe to delete.
Guided-Vision/Assets/_Recovery/
Guided-Vision/Assets/_Recovery.meta

# Meta XR dev-agent pairing settings. Contains a local access token and this machine's
# LAN address, and is regenerated per machine -- not something to share.
Guided-Vision/Assets/Resources/DevAgentSettings.asset
Guided-Vision/Assets/Resources/DevAgentSettings.asset.meta

# TextMesh Pro samples: 6.4 MB, nothing in this project references any of the 148
# assets, and they restore from Window > TextMeshPro > Import TMP Examples and Extras.
# The TMP *essentials* (Resources, Shaders, Fonts) stay tracked -- those are used.
Guided-Vision/Assets/TextMesh Pro/Examples & Extras/
Guided-Vision/Assets/TextMesh Pro/Examples & Extras.meta
